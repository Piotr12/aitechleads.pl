# Copy to .env.local (gitignored) for local development.
# GitHub OAuth App for localhost; callback URL: http://localhost:3000/auth/github/callback
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated numeric GitHub user IDs (https://api.github.com/users/<login> -> "id")
# that may open /admin and moderate any project
ADMIN_GITHUB_IDS=
# APP_URL=http://localhost:3000
